GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Lakshmi
# Set to 1 only after confirming audio tags work with vachana-vc-v1 on your account
GNANI_VC_INLINE_TAGS=0

# Gemini writes/directs scripts and analyses reference videos
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Fast model for the chat agent, and fallbacks if the main model is overloaded
GEMINI_AGENT_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Optional: Cloudinary free tier for cloud video rendering (falls back to bundled FFmpeg if unset)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
